{
  "name": "@tectonic/sdk",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "openapi-typescript ../../apps/api/openapi.json -o src/generated/api.ts",
