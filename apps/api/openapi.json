{
  "openapi": "3.0.0",
  "info": {
    "title": "Tectonic API",
    "description": "Tectonic API contract",
    "version": "0.1.0"
  },
  "paths": {
    "/settings/value": {
      "get": {
        "tags": ["settings"],
        "summary": "Get the placeholder setting value",
        "operationId": "SettingsController_getValue",
        "responses": {
          "200": {
            "description": "The current setting value",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SettingResponseDto" }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["settings"],
        "summary": "Set the placeholder setting value",
        "operationId": "SettingsController_setValue",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateSettingDto" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated setting value",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SettingResponseDto" }
              }
            }
          }
        }
      }
    },
    "/kate/reply": {
      "post": {
        "tags": ["kate"],
        "summary": "Get Kate's next reply to the Kate conversation",
        "operationId": "KateController_reply",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/KateReplyRequestDto" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Kate's reply",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/KateReplyResponseDto" }
              }
            }
          },
          "400": { "description": "Invalid Kate conversation" },
          "502": { "description": "Gemini could not reply" },
          "503": { "description": "Kate is not configured" }
        }
      }
    },
    "/kate/dossier": {
      "post": {
        "tags": ["kate"],
        "summary": "Generate the escalation dossier content from the Kate conversation",
        "operationId": "KateController_dossier",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/KateDossierRequestDto" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The generated escalation dossier content",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/KateDossierResponseDto" }
              }
            }
          },
          "400": { "description": "Invalid Kate conversation" },
          "502": { "description": "Gemini could not generate the dossier" },
          "503": { "description": "Kate is not configured" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UpdateSettingDto": {
        "type": "object",
        "required": ["value"],
        "properties": {
          "value": { "type": "string", "example": "Hello from Tectonic" }
        }
      },
      "SettingResponseDto": {
        "type": "object",
        "required": ["value"],
        "properties": {
          "value": { "type": "string", "example": "Hello from Tectonic" }
        }
      },
      "KateMessageDto": {
        "type": "object",
        "required": ["role", "text"],
        "properties": {
          "role": { "type": "string", "enum": ["customer", "kate"], "example": "customer" },
          "text": { "type": "string", "example": "Did our mortgage application for Parklaan 14 come through?" }
        }
      },
      "KateReplyRequestDto": {
        "type": "object",
        "required": ["messages"],
        "properties": {
          "messages": { "type": "array", "items": { "$ref": "#/components/schemas/KateMessageDto" } }
        }
      },
      "KateReplyResponseDto": {
        "type": "object",
        "required": ["text", "escalate"],
        "properties": {
          "text": { "type": "string", "example": "Yes, your application for a home loan of EUR 305,000 is waiting for review by a KBC advisor." },
          "escalate": { "type": "boolean", "description": "True when Kate started a human escalation; text is then her handoff message.", "example": false }
        }
      },
      "KateDossierRequestDto": {
        "type": "object",
        "required": ["messages"],
        "properties": {
          "messages": { "type": "array", "items": { "$ref": "#/components/schemas/KateMessageDto" } }
        }
      },
      "KateDossierDocumentDto": {
        "type": "object",
        "required": ["title", "type", "date", "relevance"],
        "properties": {
          "title": { "type": "string", "example": "Sales agreement (compromis) Parklaan 14" },
          "type": { "type": "string", "example": "Agreement" },
          "date": { "type": "string", "example": "30 September 2026" },
          "relevance": { "type": "string", "example": "The loan condition expires on 18 October 2026 and requires a loan of at least EUR 305,000." }
        }
      },
      "KateDossierResponseDto": {
        "type": "object",
        "required": ["summary", "unresolvedQuestion", "kateAlreadyChecked", "documents", "suggestedFirstAction"],
        "properties": {
          "summary": { "type": "string", "example": "Laura asked whether her EUR 305,000 home loan can be approved before the loan condition in her compromis expires on 18 October 2026. Her company has only two years of annual accounts." },
          "unresolvedQuestion": { "type": "string", "example": "Will our loan be approved before the loan condition expires on 18 October?" },
          "kateAlreadyChecked": { "type": "array", "items": { "type": "string" }, "example": ["The application for a EUR 305,000 home loan was received and is waiting for advisor review."] },
          "documents": { "type": "array", "items": { "$ref": "#/components/schemas/KateDossierDocumentDto" } },
          "suggestedFirstAction": { "type": "string", "example": "Check Studio Laura's annual accounts against the income requirements and confirm the 18 October deadline with Laura." }
        }
      }
    }
  }
}